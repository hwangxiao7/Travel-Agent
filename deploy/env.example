# Copy to repo root as `.env` before `docker compose -f deploy/docker-compose.yml up`
#   cp deploy/env.example .env
#
# Full option list: `.env.example` at repo root.

# --- Compose (optional) ---
HTTP_PORT=8080

# --- LLM (required for real itineraries; template = catalog-only fallback) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
OPENAI_EMBED_MODEL=text-embedding-v3
EMBEDDING_BACKEND=api

# --- Web origin (must match the URL users open in the browser) ---
# Pre-domain local smoke:
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# After HTTPS domain (uncomment and replace):
# CORS_ORIGINS=https://YOUR_DOMAIN

JWT_SECRET=change-me-before-any-public-exposure
JWT_EXPIRE_HOURS=168

# --- WeChat website OAuth (enable after 开放平台 + 备案域名 + TLS) ---
AUTH_WECHAT_ENABLED=false
# AUTH_PHONE_ENABLED=false
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/wechat/callback

# --- Optional alerts ---
# ADMIN_TOKEN=
# SMTP_HOST=
