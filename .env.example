# LLM (use one provider; set llm_provider=template to skip LLM calls)
# OPENAI_API_KEY also powers RAG: semantic destination search + grounded
# itinerary generation. Without it, search falls back to keyword matching and
# itineraries use the curated catalog.
LLM_PROVIDER=template
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# RAG embedding backend: api (OpenAI-compatible / Ollama) or local (PyTorch).
# local needs: pip install torch sentence-transformers
# First run downloads ~130MB (bge-small) + optional ~80MB (cross-encoder).
EMBEDDING_BACKEND=api
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Cross-encoder rerank after hybrid retrieval (works with either backend).
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Optional integrations
MAPBOX_TOKEN=
OPENWEATHER_API_KEY=

# Nearby "good eats & fun" comes from OpenStreetMap Overpass — free, no key needed.
# Recommended local events use the Ticketmaster Discovery API (free tier).
# Create a free key at https://developer.ticketmaster.com — without it, events are simply hidden.
TICKETMASTER_API_KEY=

# Flights (Flights Scraper Sky on RapidAPI — https://rapidapi.com/ntd119/api/flights-sky)
# Free RapidAPI account, subscribe to the Basic (free) tier, copy your key here.
# Without a key, flight search falls back to estimated flight times only.
RAPIDAPI_KEY=
RAPIDAPI_FLIGHTS_HOST=flights-sky.p.rapidapi.com

# Trending "网红打卡" spots + travel guides from TikTok (optional).
# Subscribe to a TikTok scraper API on RapidAPI (free tier), then reuse the
# same RAPIDAPI_KEY above. Set the host to whichever API you subscribed to.
# Without it, the itinerary simply omits the trending / guides sections.
RAPIDAPI_TIKTOK_HOST=tiktok-scraper7.p.rapidapi.com

# Trending "网红打卡" spots + notes from Xiaohongshu / RED (optional).
# Subscribe to a Xiaohongshu/RED scraper API on RapidAPI, reuse RAPIDAPI_KEY
# above, and set the host to whichever API you subscribed to. The search path /
# response fields vary by provider — the parser in services/social.py is tolerant,
# but you may need to tweak fetch_xhs_guides() for your specific host.
# Blank = disabled; the itinerary simply omits RED-sourced trending spots.
RAPIDAPI_XHS_HOST=

# Instagram travel posts (optional). Subscribe to an IG scraper API on RapidAPI,
# reuse RAPIDAPI_KEY above, set the host. Blank = disabled.
RAPIDAPI_INSTAGRAM_HOST=

# Reddit — AUTHORIZED discovery source (official API, preferred).
# Create an app at https://www.reddit.com/prefs/apps (type: script or web).
# Uses application-only OAuth (client_credentials); read-only public listings.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=local-discovery/0.1 by u/yourname

# Compliance gate for the RapidAPI TikTok/Instagram/RED scrapers above.
# These are UNAUTHORIZED third-party scraping — OFF by default so production /
# App Store builds never depend on them. Set true only for local dev.
ENABLE_SOCIAL_SCRAPING=false

# Trending-spot ingestion (background distillation of social posts into facts).
# Spots are kept within TRENDING_RADIUS_MILES of a destination and drop off
# serving if not re-seen within TRENDING_STALE_DAYS.
TRENDING_RADIUS_MILES=40
TRENDING_STALE_DAYS=45

# Backend
CORS_ORIGINS=http://localhost:5173

# Account / JWT (change JWT_SECRET in production)
JWT_SECRET=dev-change-me-spontaneous-travel
JWT_EXPIRE_HOURS=168
# DATABASE_URL=  # blank → sqlite file under backend/data/travel.db
