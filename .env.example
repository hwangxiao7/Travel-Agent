# LLM (use one provider; set llm_provider=template to skip LLM calls)
# OPENAI_API_KEY also powers RAG: semantic destination search + grounded
# itinerary generation. Without it, search falls back to keyword matching and
# itineraries use the curated catalog.
LLM_PROVIDER=template
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Optional integrations
MAPBOX_TOKEN=
OPENWEATHER_API_KEY=

# Nearby "good eats & fun" comes from OpenStreetMap Overpass — free, no key needed.
# Recommended local events use the Ticketmaster Discovery API (free tier).
# Create a free key at https://developer.ticketmaster.com — without it, events are simply hidden.
TICKETMASTER_API_KEY=

# Flights (Flights Scraper Sky on RapidAPI — https://rapidapi.com/ntd119/api/flights-sky)
# Free RapidAPI account, subscribe to the Basic (free) tier, copy your key here.
# Without a key, flight search falls back to estimated flight times only.
RAPIDAPI_KEY=
RAPIDAPI_FLIGHTS_HOST=flights-sky.p.rapidapi.com

# Trending "网红打卡" spots + travel guides from TikTok (optional).
# Subscribe to a TikTok scraper API on RapidAPI (free tier), then reuse the
# same RAPIDAPI_KEY above. Set the host to whichever API you subscribed to.
# Without it, the itinerary simply omits the trending / guides sections.
RAPIDAPI_TIKTOK_HOST=tiktok-scraper7.p.rapidapi.com

# Backend
CORS_ORIGINS=http://localhost:5173
