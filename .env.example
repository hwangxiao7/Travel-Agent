# LLM (use one provider; set llm_provider=template to skip LLM calls)
LLM_PROVIDER=template
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Optional integrations
MAPBOX_TOKEN=
OPENWEATHER_API_KEY=

# Flights (Amadeus Self-Service — https://developers.amadeus.com)
# Create a free app to get an API Key + Secret. Without these, flight search
# falls back to estimated flight times only (no live fares).
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Backend
CORS_ORIGINS=http://localhost:5173
